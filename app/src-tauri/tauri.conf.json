{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maata",
  "version": "0.1.0",
  "identifier": "io.github.shankarpandala.maata",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Video",
    "shortDescription": "YouTube, dubbed into Telugu on-device",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": { "../dist/": "ui/" },
    "macOS": { "minimumSystemVersion": "14.0" }
  }
}
